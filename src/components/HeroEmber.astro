---
// HeroEmber — the brand signature, large and alive on hero headlines.
// A single warm circle of ember orange, breathing, with a soft halo
// that pulses on a separate cycle. Pure CSS, no SVG gradients (those
// were producing the awkward concentric-ring look).
---

<span class="hero-ember" aria-hidden="true">
  <span class="hero-ember-glow"></span>
  <span class="hero-ember-dot"></span>
</span>

<style is:global>
  /* Sizes scale with the hero headline.
     Inline so it sits with the H1 baseline naturally. */
  .hero-ember {
    display: inline-block;
    width: clamp(2.75rem, 5.5vw, 5rem);
    height: clamp(2.75rem, 5.5vw, 5rem);
    margin-left: clamp(0.6rem, 1.2vw, 1.1rem);
    position: relative;
    vertical-align: -0.18em;
  }

  /* The dot — violet core with cool white-hot inner highlight.
     The hot point of a flame is white-blue at the center, violet at the edge. */
  .hero-ember-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 60%;
    border-radius: 50%;
    background: var(--color-cinder);
    box-shadow:
      inset 0 0 10px rgba(220, 230, 255, 0.6),
      0 0 12px rgba(142, 91, 255, 0.7),
      0 0 28px rgba(142, 91, 255, 0.45),
      0 0 56px rgba(77, 124, 255, 0.22);
    animation: dot-breathe 3s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  /* Soft halo — bigger, slower, fully behind the dot.
     Single radial fading to nothing. */
  .hero-ember-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(142, 91, 255, 0.5) 0%,
      rgba(142, 91, 255, 0.2) 35%,
      rgba(142, 91, 255, 0) 70%
    );
    filter: blur(2px);
    animation: glow-breathe 6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes dot-breathe {
    0%, 100% {
      transform: translate(-50%, -50%) scale(0.94);
      box-shadow:
        inset 0 0 8px rgba(210, 220, 255, 0.45),
        0 0 10px rgba(142, 91, 255, 0.55),
        0 0 22px rgba(142, 91, 255, 0.32),
        0 0 44px rgba(77, 124, 255, 0.18);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.06);
      box-shadow:
        inset 0 0 14px rgba(225, 235, 255, 0.75),
        0 0 16px rgba(142, 91, 255, 0.85),
        0 0 38px rgba(142, 91, 255, 0.55),
        0 0 76px rgba(77, 124, 255, 0.32);
    }
  }

  @keyframes glow-breathe {
    0%, 100% {
      transform: translate(-50%, -50%) scale(0.85);
      opacity: 0.55;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.15);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ember-dot,
    .hero-ember-glow {
      animation: none;
    }
  }
</style>
