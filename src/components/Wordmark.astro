---
const { size = "nav", tone = "light" } = Astro.props as {
  size?: "nav" | "footer" | "hero" | "section";
  tone?: "light" | "dark";
};

// Locked lockup: flame height = font-size × 0.70 × 1.6 = font-size × 1.12
// Cap-height-derived ratio so every size renders the same proportions.

const sizes = {
  hero:    { font: 88, flame: 99, opsz: 144, soft: 50 },
  section: { font: 48, flame: 54, opsz: 96,  soft: 48 },
  footer:  { font: 16, flame: 18, opsz: 24,  soft: 32 },
  nav:     { font: 20, flame: 22, opsz: 36,  soft: 36 },
} as const;

const s = sizes[size];

// Unique gradient id per render so multiple wordmarks on the same page
// don't share state.
const gid = `wm-flame-${Math.random().toString(36).slice(2, 9)}`;

// Light surface: cool→warm violet, ink-paired. Dark surface: brighter
// blue at the top so the curl reads against deep ink, plus the violet
// shifts toward blue-bright at the base for vibrancy.
const stops =
  tone === "dark"
    ? [
        { offset: "0%",  color: "#7AA0FF" },
        { offset: "55%", color: "#8E7BFF" },
        { offset: "100%", color: "#A07AFF" },
      ]
    : [
        { offset: "0%",  color: "#4D7CFF" },
        { offset: "55%", color: "#6B5BFF" },
        { offset: "100%", color: "#8E5BFF" },
      ];
---

<span class={`wordmark ${tone === "dark" ? "is-light" : ""}`}>
  <span
    class="wordmark-mark"
    style={`height: ${s.flame}px; width: ${(s.flame * 256 / 605).toFixed(2)}px;`}
  >
    <svg viewBox="0 0 256 605" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id={gid} x1="0%" y1="0%" x2="0%" y2="100%">
          {stops.map((s) => <stop offset={s.offset} stop-color={s.color} />)}
        </linearGradient>
      </defs>
      <path fill={`url(#${gid})`} d="M117 0c-10.8 4.4-13.3 6-20.1 12.6-9.4 9.2-15.5 18.2-20.9 30.5-1.1 2.5-2.5 5.4-3.1 6.5-4.6 7.8-14.2 41.3-16.3 57-.9 6-2.1 14.8-2.8 19.5-.7 4.7-1.2 16.1-1.2 25.5.1 15.5.6 21.5 4.5 48.5 1.2 8.8 6.8 31.9 10.5 44 3.4 10.8 12.7 32.8 18.9 44.5 2.6 4.9 5.4 10.3 6.3 12 3.4 6.6 14.1 21.3 19.9 27.6 6.2 6.6 6.2 6.6-18.9 31-40 38.8-60.3 62.2-75 86.4-3.9 6.6-11.7 24.1-12.4 28.2-.3 1.4-.9 3.4-1.5 4.4-1.9 3.6-4.9 23.5-4.9 32.7 0 10.2 2.5 23.6 6.5 34.7 6.8 18.7 23.4 37.3 41.5 46.5 6 3.1 20.3 7.6 26.5 8.5 2.8.3 6.4.8 8 1 25 3.3 48.4-.5 65-10.6 6.5-3.9 15.2-11.9 19.3-17.9 1.8-2.5 6.5-11.9 10.6-21 5.9-13.1 40.3-83.4 44.7-91.3 2.6-4.8 13.3-28.8 15.5-35.1 9.3-25.8 15.3-48.1 17.4-65 3.4-27.5-2-59-16.6-95.6-5.8-14.7-22.9-47.2-32.8-62.5-1.8-2.8-5.9-9.1-9.1-14-22.8-35.1-36.3-64.6-47.9-104.5-2.6-9-4.5-27.4-4.7-46-.3-20.3-2.9-35-6.9-38.2-3-2.4-13.9-2.4-20 .1z"/>
    </svg>
  </span>
  <span
    class="wordmark-text"
    style={`font-size: ${s.font}px; font-variation-settings: 'opsz' ${s.opsz}, 'SOFT' ${s.soft};`}
  >
    <span class="wordmark-slowlit">SlowLit</span><span class="wordmark-labs">Labs</span>
  </span>
</span>

<style is:global>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-ink);
  }

  .wordmark-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    flex-shrink: 0;
  }

  .wordmark-mark svg {
    display: block;
    width: 100%;
    height: 100%;
    /* Optical-balance nudge: the flame's visible mass sits below its
       geometric center because the curled tip leaves empty space at
       the top. Push the inner svg up 8% to compensate. */
    transform: translateY(-8%);
    user-select: none;
    pointer-events: none;
  }

  .wordmark-text {
    font-family: var(--font-display);
    line-height: 1;
    color: inherit;
    letter-spacing: -0.028em;
  }

  /* "SlowLit" — set together as one word, slightly bolder than "Labs".
     The visual rhythm becomes: heavier stem | space | lighter tail. */
  .wordmark-slowlit {
    font-weight: 460;
    letter-spacing: -0.032em;
  }

  /* "Labs" — quieter, lighter, sits to the right of the brand stem. */
  .wordmark-labs {
    font-weight: 340;
    letter-spacing: -0.022em;
    margin-left: 0.32em;
  }

  /* Inverted variant for dark surfaces */
  .wordmark.is-light {
    color: #FAFAF7;
  }
</style>
