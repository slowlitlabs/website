---
const { size = "nav" } = Astro.props as {
  size?: "nav" | "footer" | "hero" | "section";
};

// Locked lockup: flame height = font-size × 0.70 × 1.6 = font-size × 1.12
// Cap-height-derived ratio so every size renders the same proportions.

const sizes = {
  hero:    { font: 88, flame: 99, opsz: 144, soft: 50 },
  section: { font: 48, flame: 54, opsz: 96,  soft: 48 },
  footer:  { font: 16, flame: 18, opsz: 24,  soft: 32 },
  nav:     { font: 20, flame: 22, opsz: 36,  soft: 36 },
} as const;

const s = sizes[size];
---

<span class="wordmark">
  <span
    class="wordmark-mark"
    style={`height: ${s.flame}px;`}
  >
    <img src="/brand/flame-medium.png" alt="" />
  </span>
  <span
    class="wordmark-text"
    style={`font-size: ${s.font}px; font-variation-settings: 'opsz' ${s.opsz}, 'SOFT' ${s.soft};`}
  >
    Slow Lit Labs
  </span>
</span>

<style is:global>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-ink);
  }

  .wordmark-mark {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    flex-shrink: 0;
  }

  .wordmark-mark img {
    display: block;
    width: auto;
    height: 100%;
    /* Optical-balance nudge: the flame's visible mass sits below its
       geometric center because the curled tip leaves empty space at
       the top. Push the inner img up 8% to compensate. */
    transform: translateY(-8%);
    user-select: none;
    pointer-events: none;
  }

  .wordmark-text {
    font-family: var(--font-display);
    font-weight: 380;
    letter-spacing: -0.028em;
    line-height: 1;
    color: inherit;
  }

  /* Inverted variant for dark surfaces */
  .wordmark.is-light {
    color: #FAFAF7;
  }
</style>
