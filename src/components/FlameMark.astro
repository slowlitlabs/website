---
// FlameMark — Stoken Labs brand mark.
// Flame silhouette from SVG Repo, recolored with a clean linear gradient.
// No radial halo, no blur — just sharp filled vector with a violet→blue gradient.

const { size = 32, animated = false } = Astro.props as { size?: number; animated?: boolean };
const id = "flame-grad-" + Math.random().toString(36).slice(2, 8);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  class={animated ? "flame-mark flame-mark-animated" : "flame-mark"}
>
  <defs>
    {/* Single linear gradient: deep violet at base → bright violet → cool blue at the tip.
        Modern, flat, matches the headline accent system without any radial fuzz. */}
    <linearGradient id={id} x1="50%" y1="100%" x2="50%" y2="0%">
      <stop offset="0%" stop-color="#7A4DFF"/>
      <stop offset="50%" stop-color="#8E5BFF"/>
      <stop offset="100%" stop-color="#4D7CFF"/>
    </linearGradient>
  </defs>

  <path
    d="M20 15.0002C20 19.2547 17.3819 21.1216 15.3588 21.7512C14.9274 21.8854 14.6438 21.3825 14.9019 21.0116C15.7823 19.7464 16.8 17.8161 16.8 16.0002C16.8 14.0496 15.1559 11.7467 13.8721 10.3263C13.5786 10.0016 13.0667 10.2164 13.0507 10.6539C12.9976 12.1031 12.7689 14.042 11.7828 15.5616C11.6241 15.8062 11.2872 15.8264 11.1063 15.5977C10.7982 15.208 10.4901 14.7267 10.182 14.3464C10.016 14.1416 9.71604 14.1388 9.52461 14.32C8.77825 15.0267 7.73333 16.1288 7.73333 17.5002C7.73333 18.4301 8.0936 19.405 8.50007 20.1893C8.72368 20.6208 8.32607 21.1402 7.89573 20.9144C6.11307 19.9789 4 18.0838 4 15.0002C4 11.8538 8.31029 7.49503 9.95605 3.37712C10.2157 2.72733 11.0161 2.42199 11.5727 2.84603C14.9439 5.41409 20 10.3783 20 15.0002Z"
    fill={`url(#${id})`}
  />
</svg>

<style is:global>
  .flame-mark {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }

  .flame-mark-animated {
    transform-origin: 50% 90%;
    animation: flame-breathe 3.2s ease-in-out infinite;
  }

  @keyframes flame-breathe {
    0%, 100% { transform: scale(0.97); opacity: 0.92; }
    35%      { transform: scale(1.04); opacity: 1; }
    65%      { transform: scale(1.0);  opacity: 0.95; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flame-mark-animated { animation: none; }
  }
</style>
