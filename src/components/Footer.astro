---
import Wordmark from "./Wordmark.astro";
const year = new Date().getFullYear();
---

<footer class="shell mt-24 md:mt-32 pb-6 md:pb-10">
  <hr class="rule mb-10 md:mb-14" />

  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-10 pt-3 md:pt-5">
    <a href="/" class="group" aria-label="Stoken Labs — home">
      <Wordmark size="footer" />
    </a>

    <div class="flex flex-wrap gap-x-7 gap-y-3">
      <a href="/manifesto" class="link-quiet footer-link">Manifesto</a>
      <a href="/ember" class="link-quiet footer-link">Ember</a>
      <a href="/careers" class="link-quiet footer-link">Careers</a>
      <a href="/contact" class="link-quiet footer-link">Contact</a>
    </div>
  </div>

  <div class="mt-10 md:mt-14 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
    <p class="footer-meta">Building agents that build.</p>
    <p class="footer-meta">© {year} Stoken Labs &middot; Europe / Global</p>
  </div>
</footer>
