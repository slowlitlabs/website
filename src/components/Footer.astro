---
const year = new Date().getFullYear();
---

<footer class="shell mt-40 md:mt-56 pb-24 md:pb-32">
  <hr class="rule mb-16 md:mb-20" />

  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-10">
    <div class="flex items-baseline gap-3">
      <span style="font-family: var(--font-display); font-variation-settings: 'opsz' 36, 'SOFT' 35; font-weight: 440; font-size: 1.25rem; letter-spacing: -0.012em; color: var(--color-ink);">Cinder Labs</span>
      <span class="ember" aria-hidden="true"></span>
    </div>

    <div class="flex flex-wrap gap-x-7 gap-y-3">
      <a href="/manifesto" class="link-quiet footer-link">Manifesto</a>
      <a href="/ember" class="link-quiet footer-link">Ember</a>
      <a href="/careers" class="link-quiet footer-link">Careers</a>
      <a href="/contact" class="link-quiet footer-link">Contact</a>
    </div>
  </div>

  <div class="mt-16 md:mt-20 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
    <p class="footer-meta">Building agents that build.</p>
    <p class="footer-meta">© {year} Cinder Labs &middot; Europe / Global</p>
  </div>
</footer>
