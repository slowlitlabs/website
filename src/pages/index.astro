---
import Base from "../layouts/Base.astro";
---

<Base current="">
  <!-- Hero -->
  <section class="shell section-hero">
    <div class="measure-wide">
      <p class="mono rise rise-1">§ Research &amp; product lab</p>

      <h1 class="display-hero mt-12 md:mt-16 rise rise-2">
        Small fires.<br />
        Built to spread.<span class="ember ember-mega ml-5 md:ml-7" aria-hidden="true"></span>
      </h1>

      <p class="prose-lead mt-16 md:mt-20 measure rise rise-3">
        Cinder is a research and product lab building autonomous agents from
        Europe. We ship products people use every day. The agents that built
        them run our company.
      </p>

      <div class="mt-16 md:mt-20 rise rise-4">
        <a href="/manifesto" class="link-arrow">
          Read the manifesto <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- What we do -->
  <section class="shell section reveal">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ What we do</p>
      </div>
      <div class="md:col-span-8 measure-wide">
        <h2 class="display-large">
          Foundation models for autonomous agents, and the products that prove
          them.
        </h2>
        <div class="prose-body mt-12">
          <p>
            Our flagship model is <strong style="font-weight: 500; color: var(--color-ink);">Ember</strong>
            — a frontier model trained for sustained, multi-step work.
            Ember 1 arrives early 2027.
          </p>
        </div>
        <div class="mt-14">
          <a href="/ember" class="link-arrow">
            About Ember <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- How we work -->
  <section class="shell section reveal">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ How we work</p>
      </div>
      <div class="md:col-span-8 measure-wide">
        <h2 class="display-large">
          A small team of senior builders. No middle layers.
        </h2>
        <div class="prose-body mt-12">
          <p>
            We build the systems we depend on, and we use them before anyone
            else does.
          </p>
          <p>If they fail, we feel it first.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- Where we come from -->
  <section class="shell section reveal">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ Where we come from</p>
      </div>
      <div class="md:col-span-8 measure-wide">
        <h2 class="display-medium">
          Founded in 2026 by builders who shipped autonomous agents at scale
          before founding the lab.
        </h2>
        <div class="prose-body mt-12">
          <p>Headquartered in Europe. Working globally.</p>
        </div>
        <div class="mt-14 flex flex-wrap gap-x-12 gap-y-5">
          <a href="/careers" class="link-arrow">
            We need builders <span class="arrow">→</span>
          </a>
          <a href="/contact" class="link-arrow">
            Get in touch <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
