---
import Base from "../layouts/Base.astro";
import HeroEmber from "../components/HeroEmber.astro";
---

<Base current="">
  <!-- Hero -->
  <section class="shell hero-trim">
    <div class="measure-wide">
      <p class="mono rise rise-1">§ Research &amp; product lab · Est. 2026</p>

      <h1 class="display-hero mt-12 md:mt-16 rise rise-2">
        Small fires.<br />
        Built to spread.<HeroEmber />
      </h1>

      <p class="prose-lead mt-16 md:mt-20 measure rise rise-3">
        Cinder is a research and product lab building autonomous agents from
        Europe. We ship products people use every day. The agents that built
        them run our company.
      </p>

      <div class="mt-16 md:mt-20 rise rise-4">
        <a href="/manifesto" class="link-arrow">
          Read the manifesto <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- What we do -->
  <section class="shell section reveal">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ What we do</p>
      </div>
      <div class="md:col-span-8 measure-wide">
        <h2 class="display-large">
          Foundation models for autonomous agents, and the products that prove them.
        </h2>
        <div class="prose-body mt-12">
          <p>
            Our flagship model is <strong style="font-weight: 500; color: var(--color-ink);">Ember</strong> — a
            frontier model trained for sustained, multi-step work.
            <strong style="font-weight: 500; color: var(--color-ink);">Ember 1</strong> arrives early 2027.
          </p>
        </div>
        <div class="mt-14">
          <a href="/ember" class="link-arrow">
            About Ember <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- Pull quote — the moment of breath between sections -->
  <section class="shell section reveal">
    <div class="measure-wide">
      <p class="pull-quote" style="font-style: normal;">
        We build the systems we depend on, and we use them before anyone else does.
      </p>
      <p class="pull-quote-attribution">§ How we work · Principle 01</p>
    </div>
  </section>

  <hr class="rule" />

  <!-- How we work -->
  <section class="shell section reveal">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ How we work</p>
      </div>
      <div class="md:col-span-8 measure-wide">
        <h2 class="display-large">
          A small team of senior builders. No middle layers.
        </h2>
        <div class="prose-body mt-12">
          <p>
            Every product we ship has been operated, broken, and rebuilt by the
            agents that work alongside us.
          </p>
          <p style="color: var(--color-ink); font-weight: 500;">
            If they fail, we feel it first.
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- Where we come from -->
  <section class="shell section reveal">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ Where we come from</p>
      </div>
      <div class="md:col-span-8 measure-wide">
        <h2 class="display-medium">
          Founded in 2026 by builders who shipped autonomous agents at scale before founding the lab.
        </h2>
        <div class="prose-body mt-12">
          <p>Headquartered in Europe. Working globally.</p>
          <p style="color: var(--color-ink); font-weight: 500;">
            The lab is the proof.
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- Single closing CTA -->
  <section class="shell section reveal">
    <div class="measure-wide">
      <p class="display-medium" style="max-width: 38rem;">
        We need builders.<br />
        <span style="color: var(--color-smoke);">Not many of them.</span>
      </p>
      <div class="mt-12">
        <a href="/careers" class="link-arrow">
          Work with us <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>
