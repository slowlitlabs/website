---
import Base from "../layouts/Base.astro";
---

<Base
  current=""
  title="Logo — Slow Lit Labs"
  description="The locked Slow Lit Labs lockup."
  noindex
>
  <section class="shell hero-trim">
    <div class="measure-wide">
      <p class="mono rise rise-1">§ Logo · Locked</p>

      <h1 class="display-hero mt-12 md:mt-16 rise rise-2">
        Final<br />
        lockup.
      </h1>

      <p class="prose-lead mt-12 md:mt-16 measure rise rise-3">
        Flame at 1.6× the wordmark's cap-height, vertically centered with
        an 8% upward nudge for optical balance. Wordmark in Fraunces at
        weight 380 (regular+), all three words at equal weight. Identical
        ratio at every size.
      </p>
    </div>
  </section>

  <hr class="rule" />

  <section class="shell section reveal">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ Scale</p>
        <p class="prose-body mt-6 text-[0.95rem]" style="color: var(--color-smoke);">
          Same ratio at every surface. Fraunces' cap-height is roughly 70%
          of font-size, so flame height = font-size × 0.70 × 1.6.
        </p>
      </div>
      <div class="md:col-span-8 space-y-10">
        <div class="logo-stage">
          <div class="lockup">
            <span class="mark" style="height: 99px;"><img src="/brand/flame-medium.png" alt="" /></span>
            <span class="wm" style="font-size: 88px;">Slow Lit Labs</span>
          </div>
          <p class="logo-cap">Hero — 88px wordmark · 99px flame · 1.6× cap-height</p>
        </div>
        <div class="logo-stage">
          <div class="lockup">
            <span class="mark" style="height: 54px;"><img src="/brand/flame-medium.png" alt="" /></span>
            <span class="wm" style="font-size: 48px; font-variation-settings: 'opsz' 96, 'SOFT' 48;">Slow Lit Labs</span>
          </div>
          <p class="logo-cap">Section — 48px wordmark · 54px flame · 1.6× cap-height</p>
        </div>
        <div class="logo-stage">
          <div class="lockup">
            <span class="mark" style="height: 31px;"><img src="/brand/flame-medium.png" alt="" /></span>
            <span class="wm" style="font-size: 28px; font-variation-settings: 'opsz' 72, 'SOFT' 42;">Slow Lit Labs</span>
          </div>
          <p class="logo-cap">Sub-section / OG — 28px wordmark · 31px flame · 1.6× cap-height</p>
        </div>
        <div class="logo-stage">
          <div class="lockup">
            <span class="mark" style="height: 22px;"><img src="/brand/flame-medium.png" alt="" /></span>
            <span class="wm" style="font-size: 20px; font-variation-settings: 'opsz' 36, 'SOFT' 36;">Slow Lit Labs</span>
          </div>
          <p class="logo-cap">Nav — 20px wordmark · 22px flame · 1.6× cap-height</p>
        </div>
        <div class="logo-stage">
          <div class="lockup">
            <span class="mark" style="height: 18px;"><img src="/brand/flame-medium.png" alt="" /></span>
            <span class="wm" style="font-size: 16px; font-variation-settings: 'opsz' 24, 'SOFT' 32;">Slow Lit Labs</span>
          </div>
          <p class="logo-cap">Footer — 16px wordmark · 18px flame · 1.6× cap-height</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="shell section reveal">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ On dark</p>
        <p class="prose-body mt-6 text-[0.95rem]" style="color: var(--color-smoke);">
          Same ratio, dark surface treatment.
        </p>
      </div>
      <div class="md:col-span-8 space-y-10">
        <div class="logo-stage logo-stage-dark">
          <div class="lockup">
            <span class="mark" style="height: 99px;"><img src="/brand/flame-dark-medium.png" alt="" /></span>
            <span class="wm wm-light" style="font-size: 88px;">Slow Lit Labs</span>
          </div>
        </div>
        <div class="logo-stage logo-stage-dark">
          <div class="lockup">
            <span class="mark" style="height: 54px;"><img src="/brand/flame-dark-medium.png" alt="" /></span>
            <span class="wm wm-light" style="font-size: 48px; font-variation-settings: 'opsz' 96, 'SOFT' 48;">Slow Lit Labs</span>
          </div>
        </div>
        <div class="logo-stage logo-stage-dark">
          <div class="lockup">
            <span class="mark" style="height: 22px;"><img src="/brand/flame-dark-medium.png" alt="" /></span>
            <span class="wm wm-light" style="font-size: 20px; font-variation-settings: 'opsz' 36, 'SOFT' 36;">Slow Lit Labs</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="shell section reveal">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ Solo</p>
        <p class="prose-body mt-6 text-[0.95rem]" style="color: var(--color-smoke);">
          Mark alone for app icon and avatar use. Favicon stress test
          at native sizes.
        </p>
      </div>
      <div class="md:col-span-8 space-y-10">
        <div class="logo-stage">
          <span class="mark" style="height: 200px;"><img src="/brand/flame-medium.png" alt="" /></span>
          <p class="logo-cap">Mark only — 200px (avatar / app icon)</p>
        </div>
        <div class="logo-stage">
          <div class="favicon-row">
            <img src="/brand/flame-medium.png" alt="" style="height: 64px; width: auto;" />
            <img src="/brand/flame-medium.png" alt="" style="height: 32px; width: auto;" />
            <img src="/brand/flame-medium.png" alt="" style="height: 16px; width: auto;" />
          </div>
          <p class="logo-cap">Favicon test — 64 / 32 / 16</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .logo-stage {
    padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-paper);
  }

  .logo-stage-dark {
    background: #0E1426;
    border: 1px solid #1A2342;
  }

  .logo-cap {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-smoke-soft);
  }

  /* ───── The locked lockup ─────
     align-items: center on the parent. The flame's visible mass is
     slightly low in its bounding box, so the inner img translates up 8%
     for optical balance. */
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    line-height: 1;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .mark img {
    display: block;
    width: auto;
    height: 100%;
    transform: translateY(-8%);
  }

  /* ───── Wordmark canonical ─────
     Fraunces, weight 380 (regular+), SOFT 50 default, tight tracking. */
  .wm {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 144, "SOFT" 50;
    font-weight: 380;
    letter-spacing: -0.028em;
    color: var(--color-ink);
    line-height: 1;
    white-space: nowrap;
  }

  .wm-light { color: #FAFAF7; }

  .favicon-row {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    background: var(--color-paper-deep);
    padding: 1.5rem 2rem;
    border-radius: 4px;
  }
</style>
