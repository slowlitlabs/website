---
import Base from "../layouts/Base.astro";
import HeroEmber from "../components/HeroEmber.astro";
---

<Base
  current="ember"
  title="Ember — Slow Lit Labs"
  description="A foundation model for agents that live. Ember 1 — coming early 2027."
>
  <section class="shell section-hero pb-12 md:pb-16">
    <div class="measure-wide">
      <p class="mono rise rise-1">§ Foundation model</p>

      <h1 class="display-hero mt-12 md:mt-16 rise rise-2">
        Ember<HeroEmber />
      </h1>

      <p class="prose-lead mt-16 md:mt-20 measure rise rise-3">
        A foundation model for agents that live.
      </p>
    </div>
  </section>

  <section class="shell section reveal">
    <hr class="rule mb-12 md:mb-16" />
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ What it is</p>
      </div>
      <div class="md:col-span-8 measure">
        <p class="prose-body" style="font-size: 1.1875rem;">
          Ember is Slow Lit&apos;s foundation model. It is being built for the
          work that doesn&apos;t fit in a single prompt — sustained, stateful,
          multi-step tasks that span hours, days, or months.
        </p>
      </div>
    </div>
  </section>

  <section class="shell section reveal">
    <hr class="rule mb-12 md:mb-16" />
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ Designed for agents that live</p>
      </div>
      <div class="md:col-span-8 measure">
        <p class="prose-body" style="font-size: 1.1875rem;">
          Ember is trained on the workloads autonomous agents actually face:
          tool use across long horizons, recovery from partial failure,
          memory consolidation across sessions, judgment under ambiguity.
        </p>
        <p class="prose-body mt-8" style="font-size: 1.1875rem;">
          Not a chat model with agentic scaffolding bolted on. A model
          trained to be an agent from the first token.
        </p>
      </div>
    </div>
  </section>

  <section class="shell section reveal">
    <hr class="rule mb-12 md:mb-16" />
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-3 sticky-label">
        <p class="mono">§ Release</p>
      </div>
      <div class="md:col-span-8 measure-wide">
        <div class="flex items-baseline gap-6">
          <h2 class="display-large">Ember 1</h2>
          <span class="ember ember-large" aria-hidden="true"></span>
        </div>
        <p class="mono-soft mt-6">Coming early 2027</p>

        <div class="mt-16">
          <a href="/contact" class="link-arrow">
            Request early access <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
