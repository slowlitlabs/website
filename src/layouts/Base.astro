---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const {
  title = "Slow Lit Labs — Small fires. Built to spread.",
  description = "Slow Lit is a research and product lab building autonomous agents from Europe.",
  current,
  noindex = false,
} = Astro.props as {
  title?: string;
  description?: string;
  current?: string;
  noindex?: boolean;
};
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Mark this as the very first document parse. The .rise / .reveal
      // animations are gated on this attribute (see global.css).
      // Cleared on astro:after-swap so client-side navigations skip the
      // entrance choreography and feel instant.
      document.documentElement.setAttribute("data-first-load", "");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og.svg" />
    <meta property="og:site_name" content="Slow Lit Labs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og.svg" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#FAFAF7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate icon" href="/favicon.ico" />

    <ClientRouter />
  </head>
  <body>
    <div class="page-plasma" aria-hidden="true"></div>
    <Nav current={current} />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Reveal-on-scroll runs only on the first document load. After
      // the first ClientRouter swap we drop data-first-load — sections
      // are visible immediately on subsequent navigations and rise/
      // reveal stay still.
      function initReveal() {
        if (typeof window === "undefined") return;
        if (!document.documentElement.hasAttribute("data-first-load")) return;

        if (
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          document
            .querySelectorAll(".reveal, .rule")
            .forEach(function (el) { el.classList.add("in-view"); });
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
        );

        document
          .querySelectorAll(".reveal, .rule")
          .forEach(function (el) {
            io.observe(el);
          });
      }

      document.addEventListener("astro:page-load", initReveal);

      // Clear the flag after the first client-side swap so subsequent
      // navigations skip rise/reveal choreography.
      document.addEventListener("astro:after-swap", function () {
        document.documentElement.removeAttribute("data-first-load");
      });
    </script>
  </body>
</html>
